# --- Base de données (SQLite en local ; passer à PostgreSQL en production) ---
DATABASE_URL="file:./dev.db"

# --- URL publique du site ---
SITE_URL="http://localhost:3000"

# --- Admin (créé au seed) ---
ADMIN_EMAIL="admin@esthairandco.com"
ADMIN_PASSWORD="ChangeMe-2024!"
AUTH_SECRET="remplacez-par-une-longue-chaine-aleatoire"

# --- Paiement : "mock" (démo) ou "stripe" ---
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="remplacez-moi-webhook-secret"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (si vide : les emails sont journalisés en base + console) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ESTHAIR & CO. <no-reply@esthairandco.com>"

# --- SMS via Brevo (si BREVO_API_KEY est vide : les SMS sont journalisés en base + console) ---
BREVO_API_KEY=
# Nom d'expéditeur affiché (11 caractères max, lettres/chiffres)
SMS_SENDER=EsthairCo
# Indicatif ajouté aux numéros saisis en format local (0470…) : 32 = Belgique, 33 = France
SMS_DEFAULT_COUNTRY_CODE=32

# --- Cron (rappels, expiration des verrous) ---
CRON_SECRET="remplacez-moi-cron-secret"

# --- Uploads ---
UPLOAD_DIR="./uploads"
